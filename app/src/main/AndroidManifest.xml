<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network: backend API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Microphone: live audio monitoring -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Location: included in SOS alerts -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Foreground service: keeps mic recording when app is in background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Notifications: monitoring status + emergency alert -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="Women SOS"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service for always-on microphone monitoring -->
        <service
            android:name=".AudioMonitoringService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
